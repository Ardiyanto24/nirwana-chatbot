# Salin file ini jadi `.env` (sudah gitignored) dan isi nilai asli di sana.
# Jangan pernah commit `.env` atau menaruh nilai asli di file ini.

# API key OpenRouter (https://openrouter.ai/keys) - dipakai Milestone 1.3
# (Pemetaan Ketergantungan Turn) untuk pemanggilan LLM lewat OpenRouter.
OPENROUTER_API_KEY=

# Connection string Postgres project Supabase - dipakai Milestone 1.5 (Tarik
# Session Memory) untuk penyimpanan Session Memory + tabel roles.
# PENTING: ambil dari mode "Transaction pooler" (port 6543) atau "Session
# pooler" (port 5432) di Project Settings > Database > Connection string -
# BUKAN "Direct connection". Direct connection Supabase IPv6-only, gagal
# resolve di jaringan yang tidak mendukung IPv6 (lihat
# milestones/1.5-tarik-session-memory/decisions.md Keputusan 12).
DATABASE_URL=
