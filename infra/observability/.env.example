# Salin ke .env (gitignored) di folder yang sama, isi nilai sungguhan.

# Password admin Grafana (service grafana, docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=

# DSN Postgres role write-only exporter (Milestone 6.1, PIC 6) - dibuat via
# milestones/6.1-membangun-exporter-dasar/provision_exporter_role.py.
# Format: postgresql://nirwana_exporter_writer.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_EXPORTER_DSN=
